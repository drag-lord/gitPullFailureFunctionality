		<mappingrules id="21499d85-342d-41c7-91f7-63546382b8ca">
			<mappings>
				<mapping type="one2one">
					<source-field>ClientID</source-field>
					<destination-field>ClientIDabc</destination-field>
				</mapping>
				<mapping type="one2one">
					<source-field>InvoiceDate</source-field>
					<destination-field>InvoiceDateabc</destination-field>
				</mapping>
				<mapping type="one2one">
					<source-field>Records.ItemIDabc</source-field>
					<destination-field>Itemabc.ItemID</destination-field>
				</mapping>
				<mapping type="one2one">
					<source-field>Records.Qtyabc</source-field>
					<destination-field>Itemabc.Qty</destination-field>
				</mapping>
				<mapping type="one2one">
					<source-field>Records.Priceabc</source-field>
					<destination-field>Itemabc.Price</destination-field>
				</mapping>
				<mapping type="formula">
					<source-field><![CDATA[Records.Qtyabc * Records.Priceabc]]></source-field>
					<destination-field>Itemabc.Cost</destination-field>
				</mapping>
			</mappings>
		</mappingrules>
