	<externalmessage xsi:type="ASCIIDelimitedFormat" type="ASCIIDelimitedFormat" version="7.2.0" rulename="InvoiceIn" formattype="ASCIIDelimitedFormat" id="483816dd-66e1-41b2-8f5a-9bd09ad63b2e" >
		<standard>ASCII Delimited</standard>
		<version>1.0</version>
		<asciidelimitedfields id="a79b152b-60ac-4c59-897b-9103ee688357">
			<batchmode>true</batchmode>
			<delimiter><![CDATA[,]]></delimiter>
			<contains-header>true</contains-header>
			<contains-trailer>false</contains-trailer>
			<headerfields>
				<field xsi:type="ASCIIDelimitedFieldType">
					<name>ClientID</name>
					<datatype>String</datatype>
					<required>true</required>
				</field>
				<field xsi:type="ASCIIDelimitedFieldType">
					<name>InvoiceDate</name>
					<datatype>DateTime</datatype>
					<required>true</required>
					<dateformat>yyyyMMdd-HH:mm:ss.SSS</dateformat>
				</field>
			</headerfields>
			<datafields>
				<field xsi:type="ASCIIDelimitedSectionType">
					<name>Records</name>
					<datatype>Section</datatype>
					<minoccurs>0</minoccurs>
					<maxoccurs>-1</maxoccurs>
					<fields>
						<field xsi:type="ASCIIDelimitedFieldType">
							<name>ItemIDabc</name>
							<datatype>String</datatype>
							<required>true</required>
						</field>
						<field xsi:type="ASCIIDelimitedFieldType">
							<name>Qtyabc</name>
							<datatype>Integer</datatype>
							<required>true</required>
						</field>
						<field xsi:type="ASCIIDelimitedFieldType">
							<name>Priceabc</name>
							<datatype>Double</datatype>
							<required>true</required>
						</field>
					</fields>
				</field>
			</datafields>
			<trailerfields>
			</trailerfields>
		</asciidelimitedfields>
		<validationrules name="Default" type="FieldsValidationRules" id="e45182b5-142a-4f70-9a9d-552ad0706ada">
			<hdrvalidationrules>
				<fieldvalidations>
				</fieldvalidations>
			</hdrvalidationrules>
			<datavalidationrules>
				<fieldvalidations>
					<fieldvalidation>
						<name>Eabc</name>
						<fieldname>Records.Qtyabc</fieldname>
						<formula><![CDATA[$value > 10]]></formula>
						<severity>error</severity>
						<cascade>true</cascade>
						<error-code>EC1</error-code>
						<actionmessage><![CDATA["Invalid Qty '" + $value + "'. It should be greater than 10."]]></actionmessage>
					</fieldvalidation>
				</fieldvalidations>
			</datavalidationrules>
			<tlrvalidationrules>
				<fieldvalidations>
				</fieldvalidations>
			</tlrvalidationrules>
		</validationrules>
